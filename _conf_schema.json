{
  "log_with_bot_id": {
    "description": "日志区分机器人实例",
    "type": "bool",
    "default": true,
    "hint": "开启后日志会标注来自哪个平台实例，多 Bot 环境方便定位。日志详细程度请在 WebUI 插件详情页调整，即时生效。"
  },
  "whitelist_groups": {
    "description": "群聊白名单",
    "type": "list",
    "default": [],
    "hint": "每行填一个群号。只有列表里的群才生效；留空 = 所有群都不处理。保存后立即生效。"
  },
  "blacklist_users": {
    "description": "唤醒源黑名单",
    "type": "template_list",
    "default": [],
    "hint": "按 ID 屏蔽唤醒源：ID 填 QQ（所有群）或 群号:QQ（仅该群）；勾选要屏蔽的唤醒源（跟随窗口与其他信号同级）。",
    "templates": {
      "entry": {
        "name": "黑名单条目",
        "items": {
          "id": {
            "description": "QQ 或 群号:QQ",
            "type": "string",
            "default": ""
          },
          "sources": {
            "description": "屏蔽的唤醒源",
            "type": "list",
            "options": [
              "persona_name",
              "keyword",
              "ask",
              "bored",
              "interest",
              "similarity",
              "probability",
              "window"
            ],
            "labels": [
              "人格名",
              "关键词",
              "答疑",
              "无聊",
              "兴趣",
              "相关性",
              "概率",
              "跟随窗口"
            ],
            "default": [
              "persona_name",
              "keyword",
              "ask",
              "bored",
              "interest",
              "similarity",
              "probability",
              "window"
            ],
            "hint": "该 ID 在这些唤醒源命中时不唤醒；默认全选。"
          }
        }
      }
    }
  },
  "group_bots": {
    "description": "多 bot 分流（按群）",
    "type": "list",
    "default": [],
    "hint": "每行一个 Bot：只填机器人自身ID=所有群启用；「机器人自身ID:群号」=仅该群启用。同群多 Bot 按哈希轮流响应，单 Bot 群 100% 响应；留空关闭分流。"
  },
  "use_chat_memory": {
    "description": "启用 chat_memory 数据源",
    "type": "bool",
    "default": true,
    "hint": "从聊天记忆插件读取 Bot 的历史回复作为判断依据。关闭或不可用时自动改用 AstrBot 自带历史。"
  },
  "history_scope": {
    "description": "Bot 回复候选范围",
    "type": "string",
    "options": [
      "group",
      "user"
    ],
    "default": "group",
    "hint": "全量消息 = 全群所有用户触发的回复；对话轮 = 只看当前发送者触发的回复。仅 chat_memory 源支持按发送者过滤。"
  },
  "bot_msgs_maxlen": {
    "description": "历史条数上限",
    "type": "int",
    "default": 15,
    "hint": "候选 Bot 回复的逻辑条数上限（最大 50，建议 10-30）；chat_memory 一轮里的多条物理行会先合成为一条逻辑回复再计数。"
  },
  "persona_name_prob": {
    "description": "人格名唤醒概率",
    "type": "float",
    "slider": {
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    "default": 0.5,
    "hint": "消息包含当前生效人格名时按此概率唤醒；0=关闭。人格名实时解析，改名后立即生效。"
  },
  "keyword_words": {
    "description": "关键词列表",
    "type": "list",
    "default": [
      "BOT",
      "机器人",
      "萝卜子"
    ],
    "hint": "每行一个独立关键词，命中任一即按概率唤醒（与下面的兴趣词包不同，不做累计打分）。留空则不生效。"
  },
  "keyword_prob": {
    "description": "关键词唤醒概率",
    "type": "float",
    "slider": {
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    "default": 0.5,
    "hint": "消息包含任一关键词时按此概率唤醒；0=关闭。不区分大小写。"
  },
  "prob": {
    "description": "概率唤醒",
    "type": "float",
    "slider": {
      "min": 0,
      "max": 1,
      "step": 0.001
    },
    "default": 0.0,
    "hint": "每条消息的兜底唤醒概率；0=关闭。建议 0.01-0.1，过大会频繁插话。"
  },
  "ask_threshold": {
    "description": "答疑唤醒阈值",
    "type": "float",
    "slider": {
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    "default": 0.5,
    "hint": "消息的提问意图分数大于此值时唤醒；1=关闭。觉得插话太多就调高。"
  },
  "bored_threshold": {
    "description": "无聊唤醒阈值",
    "type": "float",
    "slider": {
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    "default": 0.5,
    "hint": "消息的无聊表达分数大于此值时唤醒；1=关闭。"
  },
  "interest_words": {
    "description": "兴趣词包",
    "type": "list",
    "default": [
      "咖啡 手冲 拉花",
      "摄影 镜头 构图"
    ],
    "hint": "每行一个兴趣词包，包内多个相关词用空格分隔；消息命中越多、词越长，分数越高，超过下方阈值才唤醒。"
  },
  "interest_threshold": {
    "description": "兴趣唤醒阈值",
    "type": "float",
    "slider": {
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    "default": 0.5,
    "hint": "关键词命中分数大于此值时唤醒；1=关闭。"
  },
  "similar_threshold": {
    "description": "相关性唤醒阈值",
    "type": "float",
    "slider": {
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    "default": 0.5,
    "hint": "与 Bot 近期回复的相似度大于此值时唤醒（越新的回复权重越高）；1=关闭。误判多就调高。"
  },
  "wake_cd": {
    "description": "唤醒冷却时间（秒）",
    "type": "float",
    "slider": {
      "min": 0,
      "max": 10,
      "step": 0.1
    },
    "default": 0.5,
    "hint": "同一用户在同一会话中两次唤醒的最小间隔（秒）；0=关闭。"
  },
  "follow_up": {
    "description": "跟随窗口",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用跟随窗口",
        "type": "bool",
        "default": false,
        "hint": "开启后，Bot 被唤醒会进入一段跟随窗口：窗口内信号照常参与，信号没命中时按「时间 × 消息距离」概率决定要不要接话；窗口结束自动回到普通唤醒。"
      },
      "window": {
        "description": "窗口长度（秒）",
        "type": "float",
        "slider": {
          "min": 0,
          "max": 600,
          "step": 5
        },
        "default": 0,
        "hint": "窗口持续时间（秒）；0 = 不启用。"
      },
      "gap": {
        "description": "消息距离上限（条）",
        "type": "int",
        "default": 0,
        "hint": "自己上一条回复后隔了多少条消息，越远回复概率越低；达到该条数概率归零。0 = 不启用距离因子。",
        "slider": {
          "min": 0,
          "max": 100,
          "step": 1
        }
      },
      "command": {
        "description": "指令也进入窗口",
        "type": "bool",
        "default": false,
        "hint": "勾选后指令前缀的消息也会开启/刷新窗口；默认豁免（管理命令不进入跟随状态）。"
      },
      "prob": {
        "description": "窗口起点概率",
        "type": "float",
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "default": 1.0,
        "hint": "窗口刚开启时的回复概率；之后按曲线衰减。曲线选 constant 时窗口内概率恒为此值。"
      },
      "curve": {
        "description": "跟随概率曲线",
        "type": "string",
        "options": [
          "constant",
          "linear",
          "exponential",
          "smooth",
          "power"
        ],
        "labels": [
          "不变",
          "线性",
          "指数",
          "平滑（S 型）",
          "幂次（先慢后快）"
        ],
        "default": "linear",
        "hint": "时间因子与消息距离因子共用的衰减形状：不变=恒定；线性=匀速下降；指数=先快后慢；平滑=两端平缓、中段最陡；幂次=先慢后快、尾部陡降。各曲线的形状图见 README。"
      },
      "allow_other_at": {
        "description": "窗口内响应 @他人 的消息",
        "type": "bool",
        "default": false,
        "hint": "开启后，窗口内「@他人/引用他人」的消息也参与判定；默认不响应（明显不是在跟本 Bot 说话）。"
      },
      "block_ids": {
        "description": "跟随黑名单（旧位置，自动迁移）",
        "type": "list",
        "default": [],
        "invisible": true,
        "hint": "1.3.7 分组里的旧位置；升级时自动合并到唤醒源黑名单，可留空。"
      }
    }
  },
  "follow_up_window": {
    "description": "窗口长度（秒）",
    "type": "float",
    "slider": {
      "min": 0,
      "max": 600,
      "step": 5
    },
    "default": 0,
    "hint": "旧版平铺位置（自动迁移到「跟随窗口」组），可留空。",
    "invisible": true
  },
  "follow_up_gap": {
    "description": "消息距离上限（条）",
    "type": "int",
    "default": 0,
    "hint": "旧版平铺位置（自动迁移到「跟随窗口」组），可留空。",
    "invisible": true,
    "slider": {
      "min": 0,
      "max": 100,
      "step": 1
    }
  },
  "follow_up_command": {
    "description": "指令也进入窗口",
    "type": "bool",
    "default": false,
    "hint": "旧版平铺位置（自动迁移到「跟随窗口」组），可留空。",
    "invisible": true
  },
  "follow_up_prob": {
    "description": "窗口起点概率",
    "type": "float",
    "slider": {
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    "default": 1.0,
    "hint": "旧版平铺位置（自动迁移到「跟随窗口」组），可留空。",
    "invisible": true
  },
  "follow_up_curve": {
    "description": "跟随概率曲线",
    "type": "string",
    "options": [
      "constant",
      "linear",
      "exponential",
      "smooth",
      "power"
    ],
    "labels": [
      "不变",
      "线性",
      "指数",
      "平滑（S 型）",
      "幂次（先慢后快）"
    ],
    "default": "linear",
    "hint": "旧版平铺位置（自动迁移到「跟随窗口」组），可留空。",
    "invisible": true
  },
  "follow_up_allow_other_at": {
    "description": "窗口内响应 @他人 的消息",
    "type": "bool",
    "default": false,
    "hint": "旧版平铺位置（自动迁移到「跟随窗口」组），可留空。",
    "invisible": true
  },
  "follow_up_block_ids": {
    "description": "跟随黑名单（旧位置，自动迁移）",
    "type": "list",
    "default": [],
    "invisible": true,
    "hint": "旧版本的跟随黑名单；升级时自动合并到唤醒源黑名单，可留空。"
  },
  "enable_reject_tool": {
    "description": "唤醒后允许 LLM 主动拒绝回复",
    "type": "bool",
    "default": false,
    "hint": "总开关。开启后，被唤醒的 Bot 判断话题不需要自己回复（比如用户在问群里另一个人）时可以主动放弃；具体哪些唤醒方式生效由下方勾选决定。"
  },
  "reject_tool_scopes": {
    "description": "拒绝回复适用的唤醒方式",
    "type": "list",
    "options": [
      "probability",
      "keyword",
      "bored",
      "interest",
      "similarity",
      "persona_name",
      "ask",
      "window"
    ],
    "default": [
      "probability",
      "keyword",
      "bored",
      "interest",
      "similarity"
    ],
    "hint": "勾选哪些唤醒方式允许 Bot 主动放弃回复；未勾选的唤醒方式即使总开关开启也不注入该能力。",
    "labels": [
      "概率",
      "关键词",
      "无聊",
      "兴趣",
      "相关性",
      "人格名",
      "答疑",
      "跟随窗口"
    ]
  }
}
